{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>metio/renovate-config"
  ],
  "customManagers": [
    {
      "description": "Bump the versions pinned in group files via a `;; renovate: datasource=… depName=… [versioning=…] [extractVersion=…]` comment directly above a `\"package@version\"` member.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)@[^/]+\\.edn$/"
      ],
      "matchStrings": [
        ";; renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s+\"[^\"@]+@(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
