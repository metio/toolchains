{:members [;; renovate: datasource=github-releases depName=astral-sh/uv
           "uv@0.13.6"
           ;; renovate: datasource=pypi depName=reuse
           "reuse@6.2.0"
           ;; renovate: datasource=pypi depName=yamllint
           "yamllint@1.38.0"
           ;; renovate: datasource=github-releases depName=crate-ci/typos extractVersion=^v(?<version>.+)$
           "typos@1.51.1"
           ;; renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.+)$
           "actionlint@1.7.12"
           ;; renovate: datasource=github-releases depName=koalaman/shellcheck extractVersion=^v(?<version>.+)$
           "shellcheck@0.11.0"
           ;; renovate: datasource=github-releases depName=Automattic/harper extractVersion=^v(?<version>.+)$
           "harper-cli@3.0.0"
           ;; renovate: datasource=github-releases depName=zizmorcore/zizmor extractVersion=^v(?<version>.+)$
           "zizmor@1.31.1"
           ;; renovate: datasource=node-version depName=node
           "node@26.13.0"
           ;; renovate: datasource=npm depName=markdownlint-cli2
           "markdownlint-cli2@0.24.0"]
 :commands {"ci-reuse" {:run ["reuse" "lint"]}
            "ci-typos" {:run ["typos"]}
            "ci-yaml" {:run ["yamllint" "."]}
            "ci-actionlint" {:run ["actionlint"]}
            "ci-zizmor" {:run ["zizmor" "--min-severity" "low" "."]
                         :description "Audit the workflows, actions and Dependabot files for security problems"}
            "ci-markdown" {:run "if [ \"$#\" -gt 0 ]; then exec markdownlint-cli2 \"$@\"; fi
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  git ls-files -z -- '*.md' '*.markdown' | xargs -0 -r markdownlint-cli2
else
  exec markdownlint-cli2 '**/*.md'
fi"
                           :description "Lint the Markdown git tracks, or the files given"}
            "ci-harper" {:run "ignore=\"SpellCheck,UseTitleCase${HARPER_IGNORE:+,$HARPER_IGNORE}\"
if [ \"$#\" -eq 0 ]; then
  for d in docs kb; do if [ -d \"$d\" ]; then set -- \"$@\" \"$d\"; fi; done
  if [ \"$#\" -eq 0 ]; then set -- .; fi
fi
find \"$@\" -name '*.md' -not -path './.git/*' -print0 | xargs -0 harper-cli lint --ignore \"$ignore\""
                         :description "Lint the prose of docs and kb, or of the paths given"}
            "ci-lint" {:depends ["ci-reuse" "ci-typos" "ci-yaml" "ci-actionlint" "ci-zizmor" "ci-markdown" "ci-harper"]
                       :description "Every lint"}}}
