{:members [;; renovate: datasource=github-releases depName=astral-sh/uv
           "uv@0.13.6"
           ;; renovate: datasource=pypi depName=reuse
           "reuse@6.2.0"
           ;; renovate: datasource=pypi depName=yamllint
           "yamllint@1.38.0"
           ;; renovate: datasource=github-releases depName=crate-ci/typos extractVersion=^v(?<version>.+)$
           "typos@1.51.1"
           ;; renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.+)$
           "actionlint@1.7.12"
           ;; renovate: datasource=github-releases depName=koalaman/shellcheck extractVersion=^v(?<version>.+)$
           "shellcheck@0.11.0"
           ;; renovate: datasource=github-releases depName=Automattic/harper extractVersion=^v(?<version>.+)$
           "harper-cli@3.0.0"
           ;; renovate: datasource=github-releases depName=jqlang/jq extractVersion=^jq-(?<version>.+)$
           "jq@1.8.2"
           ;; renovate: datasource=github-releases depName=zizmorcore/zizmor extractVersion=^v(?<version>.+)$
           "zizmor@1.31.1"
           ;; renovate: datasource=node-version depName=node
           "node@26.13.0"
           ;; renovate: datasource=npm depName=markdownlint-cli2
           "markdownlint-cli2@0.24.0"
           ;; renovate: datasource=npm depName=renovate
           "renovate@44.249.2"]
 :commands {"ci-reuse" {:run ["reuse" "lint"]}
            "ci-typos" {:run ["typos"]}
            "ci-yaml" {:run ["yamllint" "."]}
            "ci-actionlint" {:run ["actionlint"]}
            "ci-zizmor" {:run ["zizmor" "--min-severity" "low" "."]
                         :description "Audit the workflows, actions and Dependabot files for security problems"}
            "ci-markdown" {:run "if [ \"$#\" -gt 0 ]; then exec markdownlint-cli2 \"$@\"; fi
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  git ls-files -z -- '*.md' '*.markdown' | xargs -0 -r markdownlint-cli2
else
  exec markdownlint-cli2 '**/*.md'
fi"
                           :description "Lint the Markdown git tracks, or the files given"}
            "ci-harper" {:run ["bash" "-c" "set -euo pipefail
ignore=\"SpellCheck,UseTitleCase,SentenceCapitalization,SplitWords,OrthographicConsistency,ExpandConfiguration,CompoundNouns,MassNouns,Everyone${HARPER_IGNORE:+,${HARPER_IGNORE}}\"

if [ \"$#\" -eq 0 ]; then
  for dir in docs kb; do
    if [ -d \"${dir}\" ]; then set -- \"$@\" \"${dir}\"; fi
  done
  if [ \"$#\" -eq 0 ]; then set -- .; fi
fi

level=error
if [ \"${HARPER_FAIL:-true}\" = false ]; then level=warning; fi

files=()
while IFS= read -r -d '' file && IFS= read -r -d '' _ && IFS= read -r -d '' generated; do
  case \"${generated}\" in
    set | true) ;;
    *) files+=(\"${file}\") ;;
  esac
done < <(git ls-files -z -- \"$@\" | { grep -zE '\\.(md|markdown)$' || true; } | git check-attr -z --stdin linguist-generated)
if [ \"${#files[@]}\" -eq 0 ]; then exit 0; fi

# harper reports one entry per input, in input order, and names each file by
# its base name only, so the paths are matched back by position.
errors=$(mktemp)
trap 'rm -f \"${errors}\"' EXIT
status=0
report=$(harper-cli lint --format json --ignore \"${ignore}\" \"${files[@]}\" 2> \"${errors}\") || status=$?
if ! printf '%s' \"${report}\" | jq -e --argjson n \"${#files[@]}\" 'type == \"array\" and length == $n' > /dev/null 2>&1; then
  cat \"${errors}\" >&2
  echo \"[ERROR] harper-cli exited with ${status} and no report of every file\" >&2
  exit 2
fi
lines=$(printf '%s' \"${report}\" | jq -r --args --arg level \"${level}\" --arg actions \"${GITHUB_ACTIONS:-}\" '
  [., $ARGS.positional] | transpose[] | .[1] as $path | .[0].lints[]
  | \"\\($path):\\(.line):\\(.column): \\(.kind)::\\(.rule): \\(.message)\",
    (select($actions != \"\") | \"::\\($level) file=\\($path),line=\\(.line),col=\\(.column),title=\\(.kind)::\\(.rule)::\\(.message)\")
' \"${files[@]}\")
if [ -n \"${lines}\" ]; then printf '%s\\n' \"${lines}\"; fi
findings=$(printf '%s' \"${report}\" | jq '[.[].lint_count] | add // 0')

if [ \"${findings}\" -gt 0 ]; then
  echo \"[INFO] harper found ${findings} problems in the prose\"
  if [ \"${level}\" = error ]; then exit 1; fi
fi" "ci-harper"]
                         :description "Lint the prose of docs and kb, or of the paths given, with the rules of metio/ci/harper"}
            "ci-renovate" {:run ["renovate-config-validator"]
                           :description "Validate the repository's Renovate configuration"}
            "ci-lint" {:depends ["ci-typos" "ci-yaml" "ci-actionlint" "ci-zizmor" "ci-markdown" "ci-renovate"]
                       :description "The lints every repository runs in CI"}}}
